{
    "data_flow_id": "stream_static_streaming_dwh",
    "data_flow_group": "stream_static_silver",
    "data_flow_type": "nodespec",
    "nodes": [
        {
            "name": "target_stream_static_stg_customer_streaming_dwh_appnd_keys",
            "node_type": "target",
            "config": {
                "table": "stream_static_stg_customer_streaming_dwh_appnd_keys",
                "sources": [
                    {
                        "view": "v_stream_static_customer_streaming_dwh",
                        "flow": "f_stream_static_customer_streaming_dwh"
                    },
                    {
                        "view": "v_stream_static_customer_streaming_dwh_address",
                        "flow": "f_stream_static_customer_streaming_dwh_address"
                    }
                ]
            }
        },
        {
            "name": "target_stream_static_stg_customer_streaming_dwh_merge_keys",
            "node_type": "target",
            "config": {
                "table": "stream_static_stg_customer_streaming_dwh_merge_keys",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true"
                },
                "cdc_settings": {
                    "keys": [
                        "CUSTOMER_ID"
                    ],
                    "scd_type": "2",
                    "sequence_by": "LOAD_TIMESTAMP",
                    "where": "",
                    "except_column_list": [
                        "LOAD_TIMESTAMP"
                    ]
                },
                "sources": [
                    {
                        "view": "v_stream_static_stg_customer_streaming_dwh_appnd_keys",
                        "flow": "f_stream_static_customer_streaming_dwh_merge_keys"
                    }
                ]
            }
        },
        {
            "name": "v_stream_static_customer_streaming_dwh",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "database": "{bronze_schema}",
                "table": "base_customer_append",
                "cdf_enabled": true,
                "select_exp": [
                    "CUSTOMER_ID",
                    "LOAD_TIMESTAMP"
                ]
            }
        },
        {
            "name": "v_stream_static_customer_streaming_dwh_address",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "database": "{bronze_schema}",
                "table": "base_customer_address_append",
                "cdf_enabled": true,
                "select_exp": [
                    "CUSTOMER_ID",
                    "LOAD_TIMESTAMP"
                ]
            }
        },
        {
            "name": "v_stream_static_stg_customer_streaming_dwh_appnd_keys",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "table": "stream_static_stg_customer_streaming_dwh_appnd_keys",
                "as_view": false
            }
        },
        {
            "name": "v_stream_static_customer_streaming_dwh_transform",
            "node_type": "source",
            "source_type": "delta_join",
            "config": {
                "mode": "stream",
                "sources": [
                    {
                        "database": "live",
                        "table": "stream_static_stg_customer_streaming_dwh_merge_keys",
                        "cdf_enabled": true,
                        "alias": "drv",
                        "join_mode": "stream"
                    },
                    {
                        "database": "{bronze_schema}",
                        "table": "base_customer_append",
                        "cdf_enabled": false,
                        "alias": "c",
                        "join_mode": "static"
                    },
                    {
                        "database": "{bronze_schema}",
                        "table": "base_customer_address_append",
                        "cdf_enabled": false,
                        "alias": "ca",
                        "join_mode": "static"
                    }
                ],
                "joins": [
                    {
                        "join_type": "inner",
                        "condition": "drv.CUSTOMER_ID = c.CUSTOMER_ID"
                    },
                    {
                        "join_type": "inner",
                        "condition": "drv.CUSTOMER_ID = ca.CUSTOMER_ID"
                    }
                ],
                "select_exp": [
                    "c.CUSTOMER_ID",
                    "c.FIRST_NAME",
                    "c.LAST_NAME",
                    "c.EMAIL",
                    "ca.CITY",
                    "ca.STATE",
                    "c.DELETE_FLAG",
                    "drv.__START_AT"
                ]
            }
        },
        {
            "name": "target_stream_static_customer_streaming_dwh",
            "node_type": "target",
            "config": {
                "database": "{silver_schema}",
                "table": "stream_static_customer_streaming_dwh",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true"
                },
                "cdc_settings": {
                    "keys": [
                        "CUSTOMER_ID"
                    ],
                    "scd_type": "2",
                    "sequence_by": "__START_AT",
                    "except_column_list": [
                        "__START_AT"
                    ],
                    "ignore_null_updates": false,
                    "apply_as_deletes": "DELETE_FLAG = 1"
                },
                "sources": [
                    {
                        "view": "v_stream_static_customer_streaming_dwh_transform",
                        "flow": "f_stream_static_customer_streaming_dwh_target"
                    }
                ]
            }
        }
    ]
