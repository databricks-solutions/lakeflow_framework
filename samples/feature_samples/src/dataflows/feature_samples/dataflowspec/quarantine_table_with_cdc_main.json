{
    "data_flow_id": "feature_cdc_with_quarantine_table",
    "data_flow_group": "feature_samples_data_quality",
    "data_flow_type": "nodespec",
    "nodes": [
        {
            "name": "v_customer_address_feature_quarantine_table_cdc",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "database": "{feature_schema}",
                "table": "src_customer_address",
                "cdf_enabled": true,
                "select_exp": [
                    "CUSTOMER_ID",
                    "CITY",
                    "STATE",
                    "LOAD_TIMESTAMP"
                ]
            }
        },
        {
            "name": "target_tgt_cdc_with_quarantine_table",
            "node_type": "target",
            "config": {
                "database": "{feature_schema}",
                "table": "tgt_cdc_with_quarantine_table",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true"
                },
                "schema_path": "target/customer_address_schema.json",
                "cdc_settings": {
                    "keys": [
                        "CUSTOMER_ID"
                    ],
                    "sequence_by": "LOAD_TIMESTAMP",
                    "scd_type": "2"
                },
                "data_quality": {
                    "enabled": true,
                    "expectations_path": "./customer_address_dqe.json",
                    "quarantine": {
                        "mode": "table",
                        "target": {
                            "target_format": "delta"
                        }
                    }
                },
                "sources": [
                    "v_customer_address_feature_quarantine_table_cdc"
                ]
            }
        }
    ]
}
