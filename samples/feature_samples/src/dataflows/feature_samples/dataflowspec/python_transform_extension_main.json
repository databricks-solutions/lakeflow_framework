                "mode": "stream",
                "database": "{feature_schema}",
                "table": "src_customer",
                "cdf_enabled": true,
                "python_transform": {
                    "module": "transforms.customer_aggregation"
                }
            }
        },
        {
            "name": "target_tgt_python_extension_transform",
