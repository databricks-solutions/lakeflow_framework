            "config": {
                "database": "{feature_schema}",
                "table": "tgt_python_extension_transform",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true"
                },
                "schema_path": "target/feature_python_function_transform_schema.json",
                "sources": [
                    "v_python_extension_transform"
                ]
            }
        }
    ]
