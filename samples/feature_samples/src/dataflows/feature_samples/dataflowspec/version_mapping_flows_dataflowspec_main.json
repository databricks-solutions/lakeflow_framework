            "config": {
                "table": "stg_version_mapping",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true"
                },
                "cdc_settings": {
                    "keys": [
                        "CUSTOMER_ID"
                    ],
                    "sequence_by": "LOAD_TIMESTAMP",
                    "ignore_null_updates": true,
                    "scd_type": "1"
                },
                "sources": [
                    {
                        "view": "v_flows_version_mapping",
                        "flow": "f_version_mapping_merge"
                    }
                ]
            }
        },
        {
            "name": "v_flows_version_mapping",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "database": "{feature_schema}",
                "table": "src_customer",
                "cdf_enabled": true
            }
        },
        {
            "name": "v_version_mapping_final",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "database": "live",
                "table": "stg_version_mapping",
                "cdf_enabled": true
            }
        },
        {
            "name": "target_tgt_version_mapping_flows",
