                    "delta.enableChangeDataFeed": "true"
                },
                "schema_path": "target/feature_version_mapping_flows_schema.json",
                "cdc_settings": {
                    "keys": [
                        "CUSTOMER_ID"
                    ],
                    "sequence_by": "LOAD_TIMESTAMP",
