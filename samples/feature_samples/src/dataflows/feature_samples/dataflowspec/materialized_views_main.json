{
    "data_flow_id": "feature_materialized_views",
    "data_flow_group": "feature_samples_general",
    "data_flow_type": "nodespec",
    "nodes": [
        {
            "name": "v_mv_source_view",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "batch",
                "database": "{feature_schema}",
                "table": "src_customer"
            }
        },
        {
            "name": "target_mv_source_view",
            "node_type": "target",
            "config": {
                "table": "mv_source_view",
                "table_type": "mv",
                "sources": [
                    "v_mv_source_view"
                ]
            }
        },
        {
            "name": "target_mv_sql_path",
            "node_type": "target",
            "config": {
                "table": "mv_sql_path",
                "table_type": "mv",
                "sql_path": "./feature_mv_sql_path.sql"
            }
        },
        {
            "name": "target_mv_sql_statement",
            "node_type": "target",
            "config": {
                "table": "mv_sql_statement",
                "table_type": "mv",
                "sql_statement": "SELECT * FROM {feature_schema}.src_customer",
                "private": true
            }
        },
        {
            "name": "target_mv_with_quarantine",
            "node_type": "target",
            "config": {
                "table": "mv_with_quarantine",
                "table_type": "mv",
                "sql_statement": "SELECT * FROM {feature_schema}.src_customer_address",
                "data_quality": {
                    "enabled": true,
                    "expectations_path": "./customer_address_dqe.json",
                    "quarantine": {
                        "mode": "table",
                        "target": {
                            "target_format": "delta",
                            "cluster_by_auto": true
                        }
                    }
                }
            }
        },
        {
            "name": "target_mv_chain_mvs",
            "node_type": "target",
            "config": {
                "table": "mv_chain_mvs",
                "table_type": "mv",
                "sql_statement": "SELECT * FROM live.mv_sql_statement",
                "comment": "Test Config",
                "spark_conf": {
                    "spark.sql.session.timeZone": "Australia/Sydney"
                }
            }
        },
        {
            "name": "target_mv_with_refresh_policy",
            "node_type": "target",
            "config": {
                "table": "mv_with_refresh_policy",
                "table_type": "mv",
                "sql_statement": "SELECT * FROM {feature_schema}.src_customer",
                "refresh_policy": "incremental_strict",
                "config_flags": [
                    "disable_operational_metadata"
                ]
            }
        }
    ]
}
