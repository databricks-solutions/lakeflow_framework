{
    "data_flow_id": "feature_columns_to_update_except_snapshot",
    "data_flow_group": "feature_samples_snapshots",
    "data_flow_type": "nodespec",
    "nodes": [
        {
            "name": "target_stg_columns_to_update_except_snapshot",
            "node_type": "target",
            "config": {
                "table": "stg_columns_to_update_except_snapshot",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true"
                },
                "config_flags": [
                    "disable_operational_metadata"
                ],
                "cdc_snapshot_settings": {
                    "keys": [
                        "CUSTOMER_ID"
                    ],
                    "scd_type": "1",
                    "snapshot_type": "historical",
                    "source_type": "file",
                    "source": {
                        "format": "csv",
                        "path": "{sample_file_location}/snapshot_customer_columns_to_update/customer_{version}.csv",
                        "reader_options": {
                            "header": "true"
                        },
                        "version_type": "timestamp",
                        "datetime_format": "%Y_%m_%d",
                        "schema_path": "source/feature_columns_to_update_except_customer_schema.json",
                        "select_exp": [
                            "CUSTOMER_ID",
                            "FIRST_NAME",
                            "LAST_NAME",
                            "EMAIL",
                            "TO_TIMESTAMP(LOAD_TIMESTAMP, 'yyyy-MM-dd HH:mm:ss') AS LOAD_TIMESTAMP",
                            "_metadata AS meta_file_metadata"
                        ]
                    }
                }
            }
        },
        {
            "name": "v_columns_to_update_except_snapshot",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "database": "live",
                "table": "stg_columns_to_update_except_snapshot",
                "cdf_enabled": true,
                "select_exp": [
                    "*",
                    "_change_type AS meta_cdc_change_type",
                    "_commit_version AS meta_cdc_commit_version"
                ],
                "starting_version_from_dlt_setup": true,
                "cdf_change_type_override": [
                    "insert",
                    "update_preimage",
                    "update_postimage",
                    "delete"
                ]
            }
        },
        {
            "name": "target_tgt_columns_to_update_except_snapshot",
            "node_type": "target",
            "config": {
                "database": "{feature_schema}",
                "table": "tgt_columns_to_update_except_snapshot",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true"
                },
                "config_flags": [
                    "disable_operational_metadata"
                ],
                "cdc_settings": {
                    "keys": [
                        "CUSTOMER_ID"
                    ],
                    "scd_type": "2",
                    "sequence_by": "LOAD_TIMESTAMP",
                    "except_column_list": [
                        "LOAD_TIMESTAMP"
                    ],
                    "columns_to_update_except_column_list": [
                        "meta_file_metadata"
                    ]
                },
                "sources": [
                    {
                        "view": "v_columns_to_update_except_snapshot",
                        "flow": "f_columns_to_update_except_snapshot_merge_flow"
                    }
                ]
            }
        }
    ]
}
