{
    "template": "cdc_stream_from_snapshot_template",
    "global_defaults": {
        "cdcKeys": [
            "CUSTOMER_ID"
        ],
        "sequenceByColumn": "LOAD_TIMESTAMP"
    },
    "parameter_sets": [
        {
            "dataFlowId": "template_customer",
            "sourceTable": "customer",
            "targetTable": "tgt_customer_template",
            "schemaPath": "customer_schema.json"
        },
        {
            "dataFlowId": "template_customer_address",
            "sourceTable": "customer_address",
            "targetTable": "tgt_customer_address_template",
            "schemaPath": "customer_address_schema.json"
        }
    ]
}
