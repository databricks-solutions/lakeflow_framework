{
    "data_flow_id": "orders",
    "data_flow_group": "tpch_silver",
    "data_flow_type": "nodespec",
    "nodes": [
        {
            "name": "v_orders",
            "node_type": "source",
            "source_type": "delta",
            "config": {
                "mode": "stream",
                "database": "{bronze_order_mgmt_schema}",
                "table": "orders",
                "cdf_enabled": true,
                "select_exp": [
                    "o_orderkey as order_key",
                    "o_custkey as customer_key",
                    "o_orderstatus as order_status",
                    "o_totalprice as total_price",
                    "o_orderdate as order_date",
                    "o_orderpriority as order_priority",
                    "o_clerk as clerk",
                    "o_shippriority as ship_priority",
                    "o_comment as comment",
                    "load_timestamp"
                ]
            }
        },
        {
            "name": "target_orders",
            "node_type": "target",
            "config": {
                "database": "{silver_schema}",
                "table": "orders",
                "table_properties": {
                    "delta.enableChangeDataFeed": "true",
                    "delta.enableRowTracking": "true"
                },
                "schema_path": "orders_schema.json",
                "data_quality": {
                    "enabled": true,
                    "expectations_path": "./orders_dqe.json",
                    "quarantine": {
                        "mode": "table",
                        "target": {
                            "target_format": "delta",
                            "database": "{silver_schema}"
                        }
                    }
                },
                "input_flows": [
                    {
                        "view": "v_orders",
                        "flow": "f_v_orders"
                    }
                ]
            }
        }
    ]
}
