{
    "name": "bronze_parquet_ingestion_template",
    "parameters": {
        "dataFlowId": {
            "type": "string",
            "required": true
        },
        "sourceSystem": {
            "type": "string",
            "required": true
        },
        "sourceViewName": {
            "type": "string",
            "required": true
        },
        "path": {
            "type": "string",
            "required": true
        },
        "database": {
            "type": "string",
            "required": true
        },
        "table": {
            "type": "string",
            "required": true
        }
    },
    "template": {
        "data_flow_id": "${param.dataFlowId}",
        "data_flow_group": "tpch_bronze",
        "data_flow_type": "nodespec",
        "nodes": [
            {
                "name": "${param.sourceViewName}",
                "node_type": "source",
                "source_type": "cloud_files",
                "config": {
                    "mode": "stream",
                    "path": "${param.path}",
                    "reader_options": {
                        "cloudFiles.format": "parquet",
                        "cloudFiles.schemaEvolutionMode": "addNewColumns",
                        "pathGlobFilter": "*.parquet"
                    }
                }
            },
            {
                "name": "target_${param.table}",
                "node_type": "target",
                "config": {
                    "database": "${param.database}",
                    "table": "${param.table}",
                    "table_properties": {
                        "delta.enableChangeDataFeed": "true"
                    },
                    "sources": [
                        "${param.sourceViewName}"
                    ]
                }
            }
        ]
    }
}
